APP_NAME="Gerador de Ata de Reuniao por IA"
APP_ENV=development
FRONTEND_ORIGIN=http://127.0.0.1:5173
STORAGE_DIR=storage
DATABASE_BACKEND=sqlite
DATABASE_PATH=storage/ataai.sqlite3
AUTH_SESSION_DAYS=30
# Futuro PostgreSQL:
# DATABASE_BACKEND=postgres
# DATABASE_URL=postgresql://ataai:senha@localhost:5432/ataai
MAX_UPLOAD_BYTES=524288000
MAX_MEDIA_DURATION_SECONDS=10800
# Opcional: se estiverem no PATH ou instalados via `npm.cmd install --prefix tools`, nao precisa alterar.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe
LOCAL_MEDIA_TOOLS_ENABLED=true

TRANSCRIPTION_PROVIDER=gemini
TRANSCRIPTION_MODEL=gemini-2.5-flash
TRANSCRIPTION_LANGUAGE=pt
TRANSCRIPTION_MAX_FILE_BYTES=18874368
TRANSCRIPTION_CHUNK_SECONDS=600
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

MINUTES_PROVIDER=gemini
MINUTES_MODEL=gemini-2.5-flash
MINUTES_MAX_TRANSCRIPT_CHARS=60000

# Opcional: mantido como fallback se quisermos comparar provedores.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
